{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://photolocation.local/schemas/gazetteer-entry.schema.json",
  "title": "Gazetteer entry",
  "description": "One supported place. See plan.md §11.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "country", "countryCode", "lat", "lng", "aliases", "historicalNames"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 1 },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "historicalNames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
